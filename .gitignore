# Archive — tracked subdirs (esp32_uart_bridge, frontend) plus local-only clutter
# Only ignore the local-only stuff, not the git-tracked moves
archive/*
!archive/esp32_uart_bridge/
!archive/frontend/

# FNIRSI firmware binaries (copyrighted)
*.bin
*.zip

# Ghidra project files (large, binary, regenerable)
ghidra_project/

# Ghidra output artifacts
*.png.entropy

# macOS
.DS_Store

# Cloned reference repos (users should clone these themselves)
FNIRSI-1013D-1014D-Hack/
FNIRSI_1013D_Firmware/
FNIRSI_1014D_Firmware/

# Build output
firmware/build/
firmware/bootloader/build/
firmware/stock_dispatcher/build/

# Isolated build dirs used by scripts/test_firmware_build.py. Kept separate
# from build/ on purpose: the gate must never be what populates the artifact
# other suites read (see that file's docstring).
firmware/build-gate-*/
firmware/bootloader/build-gate/

# Compiled test binaries (keep .c source, ignore executables)
firmware/tests/test_automotive
firmware/tests/test_bode_mask
firmware/tests/test_component
firmware/tests/test_config_screenshot
firmware/tests/test_decode
firmware/tests/test_decode_kline
firmware/tests/test_decode_noisy
firmware/tests/test_esp_comm
firmware/tests/test_fft
firmware/tests/test_flash_regions
firmware/tests/test_font
firmware/tests/test_math_measure
firmware/tests/test_persistence
firmware/tests/test_siggen
firmware/tests/test_theme
firmware/tests/test_waterfall_blit
firmware/tests/test_xy_roll_trend

# Compiled emulator tools
emulator/lcd_viewer

# Cloned dependencies (users clone themselves).
# Both spellings on purpose: the trailing-slash form matches a real directory,
# the bare form also matches a SYMLINK to one. A git worktree does not inherit
# these trees from the main checkout, so symlinking them across is the normal
# way to build there -- and such a symlink is machine-specific and must never
# be committed.
firmware/FreeRTOS/
firmware/gd32f30x_lib/
firmware/at32f403a_lib/
firmware/at32f403a_gcc/
firmware/FreeRTOS
firmware/gd32f30x_lib
firmware/at32f403a_lib
firmware/at32f403a_gcc

# Python
**/__pycache__/
*.pyc

# Raw decompiled source (copyright — keep analysis docs, not full dumps)
reverse_engineering/decompiled_*.c

# IDE files
.vscode/
*.swp
*~

# Community directory (private, never committed)
community.md

# Local per-machine agent notes (dev-box specific, never committed)
CLAUDE.local.md

# Environment files (API keys, secrets)
.env
scripts/.env

# Node.js
node_modules/

# FNIRSI copyrighted SPI-flash dump + carved assets — local RE/backup only, do NOT publish
archive/w25q128_dump_*.bin
archive/w25q128_assets/
reverse_engineering/captures/export/

# Stray bench photos / screenshots dropped in the repo root (keep docs/images/ committable)
/*.jpeg
/*.jpg
/*.HEIC
/*.heic
/*.png

# Bench signal-generator sketch (machine-specific, per-bench)
# esp32_siggen/ is now PUBLISHED (2026-08-17) -- it is the signal source every
# bench experiment in docs/experiments/ is run against, so others cannot
# reproduce our results without it.
# /esp32_siggen/
.claude/worktrees/
